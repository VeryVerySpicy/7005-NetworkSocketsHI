digraph finite_state_machine {
    fontname="Helvetica,Arial,sans-serif"
    node [fontname="Helvetica,Arial,sans-serif"]
    edge [fontname="Helvetica,Arial,sans-serif"]
    rankdir=TB;
    size="7.5,7.5";
    ratio="fill";
    node [shape = doublecircle]; START, EXIT;
    node [shape = box];
START -> PARSE_ARGS [label = "parseArgs"];
PARSE_ARGS -> WAITING [label = "waitForWork"];
WAITING -> DECRYPTING_MSG [label = "decryptMsg"];
DECRYPTING_MSG -> CLEANUP [label = "cleanup"];
CLEANUP -> EXIT;
}